{
  "opencollection": "1.0.0",
  "info": {
    "name": "NewsBlur authentication feed-management API",
    "version": "2026.07"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "newsblur_sessionid",
      "value": "{{newsblur_sessionid}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "feed-management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Subscribe to a feed or website URL",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/add_url"
          },
          "docs": "Subscribe to a feed or website URL"
        },
        {
          "info": {
            "name": "Create a folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/add_folder"
          },
          "docs": "Create a folder"
        },
        {
          "info": {
            "name": "Move a feed to a folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/move_feed_to_folder"
          },
          "docs": "Move a feed to a folder"
        },
        {
          "info": {
            "name": "Move a folder into another folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/move_folder_to_folder"
          },
          "docs": "Move a folder into another folder"
        },
        {
          "info": {
            "name": "Rename a feed",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/rename_feed"
          },
          "docs": "Rename a feed"
        },
        {
          "info": {
            "name": "Rename a folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/rename_folder"
          },
          "docs": "Rename a folder"
        },
        {
          "info": {
            "name": "Unsubscribe from a feed",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/delete_feed"
          },
          "docs": "Unsubscribe from a feed"
        },
        {
          "info": {
            "name": "Delete a folder and unsubscribe its feeds",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/delete_folder"
          },
          "docs": "Delete a folder and unsubscribe its feeds"
        },
        {
          "info": {
            "name": "Reorder feeds and folders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/save_feed_order"
          },
          "docs": "Reorder feeds and folders"
        },
        {
          "info": {
            "name": "Create a saved-search shortcut",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/save_search"
          },
          "docs": "Create a saved-search shortcut"
        },
        {
          "info": {
            "name": "Remove a saved-search shortcut",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.newsblur.com/reader/delete_search"
          },
          "docs": "Remove a saved-search shortcut"
        }
      ]
    }
  ],
  "bundled": true
}